# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Keep the quotes: without them, the # in C##foodie would start a comment.
DB_USER="C##foodie"
DB_PASSWORD="your_oracle_password"
# Run "npx tsx scripts/ip_update.ts" to fill in the Windows host IP for WSL
DB_CONNECT_STRING="localhost:1521/XE"
